<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.github.clawagent</groupId>
        <artifactId>springboot-claw-agent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>claw-agent-server</artifactId>
    <name>claw-agent-server</name>
    <dependencies>
        <dependency>
            <groupId>com.github.clawagent</groupId>
            <artifactId>claw-agent-spring-boot-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.clawagent</groupId>
            <artifactId>claw-agent-intent</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.clawagent</groupId>
            <artifactId>claw-agent-channel</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.clawagent</groupId>
            <artifactId>claw-agent-channel-feishu</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.clawagent</groupId>
            <artifactId>claw-agent-channel-dingtalk</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.clawagent</groupId>
            <artifactId>claw-agent-channel-ddio</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.clawagent</groupId>
            <artifactId>claw-agent-worker</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
