<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.github.clawagent</groupId>
    <artifactId>springboot-claw-agent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>springboot-claw-agent</name>
    <description>ClawAgent Java Harness Agent framework</description>

    <modules>
        <module>claw-agent-core</module>
        <module>claw-agent-spi</module>
        <module>claw-agent-runtime</module>
        <module>claw-agent-memory</module>
        <module>claw-agent-persistence-sqlite</module>
        <module>claw-agent-model-spring-ai</module>
        <module>claw-agent-mcp</module>
        <module>claw-agent-skill</module>
        <module>claw-agent-intent</module>
        <module>claw-agent-channel</module>
        <module>claw-agent-channel-feishu</module>
        <module>claw-agent-channel-dingtalk</module>
        <module>claw-agent-channel-ddio</module>
        <module>claw-agent-worker</module>
        <module>claw-agent-toolkit</module>
        <module>claw-agent-knowledge</module>
        <module>claw-agent-observability</module>
        <module>claw-agent-security</module>
        <module>claw-agent-spring-boot-starter</module>
        <module>claw-agent-server</module>
        <module>claw-agent-samples</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring.boot.version>3.2.5</spring.boot.version>
        <sqlite.jdbc.version>3.45.3.0</sqlite.jdbc.version>
        <jvector.version>4.0.0-rc.8</jvector.version>
        <hutool.version>5.8.36</hutool.version>
        <jsoup.version>1.17.2</jsoup.version>
        <commons-exec.version>1.4.0</commons-exec.version>
        <lark.oapi.version>2.4.21</lark.oapi.version>
        <dingtalk.stream.version>1.3.5</dingtalk.stream.version>
        <bouncycastle.version>1.78.1</bouncycastle.version>
        <jna.version>5.14.0</jna.version>
        <junit.jupiter.version>5.10.2</junit.jupiter.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <release>${java.version}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring.boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
